<?xml version="1.0" encoding="utf-8"?>
<!-- 알림 카드 위를 사선으로 지나가는 빛(1.34). 3.6초마다 한 번: 1.3초 동안 왼쪽 밖 → 오른쪽 밖으로 쓸고 지나간 뒤 쉰다.
     ProgressBar 의 indeterminateDrawable 로 붙여야 알림(RemoteViews) 안에서도 저절로 돈다(안드로이드 기본 원형 진행 표시와 같은 방식) -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="360dp" android:height="72dp" android:viewportWidth="360" android:viewportHeight="72">
            <group android:name="sweep" android:translateX="-90">
                <path android:pathData="M-30,0 L30,0 L-10,72 L-70,72 Z">
                    <aapt:attr name="android:fillColor">
                        <gradient android:type="linear" android:startX="-42.9" android:startY="23.3" android:endX="2.9" android:endY="48.7">
                            <item android:offset="0" android:color="#00FFFFFF" />
                            <item android:offset="0.32" android:color="#24FF8A8E" />
                            <item android:offset="0.5" android:color="#47FFFFFF" />
                            <item android:offset="0.68" android:color="#24FF8A8E" />
                            <item android:offset="1" android:color="#00FFFFFF" />
                        </gradient>
                    </aapt:attr>
                </path>
            </group>
        </vector>
    </aapt:attr>
    <target android:name="sweep">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="3600" android:repeatCount="infinite" android:valueType="floatType">
                <propertyValuesHolder android:propertyName="translateX">
                    <keyframe android:fraction="0" android:value="-90" />
                    <keyframe android:fraction="0.36" android:value="460" android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <keyframe android:fraction="1" android:value="460" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
</animated-vector>
